# Copy to .env (git-ignored) on the production host and fill in real values.
# docker-compose.prod.yml refuses to start without the required ones.

# Django signing key — also signs JWTs. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Rotating it invalidates all active sessions/tokens (users re-login).
SECRET_KEY=

# Database
DB_NAME=orderq
DB_USER=postgres
DB_PASSWORD=

# Public host(s) of this deployment
ALLOWED_HOSTS=orderq.example.com,localhost,backend
FRONTEND_URL=https://orderq.example.com
CSRF_TRUSTED_ORIGINS=https://orderq.example.com
CORS_ALLOWED_ORIGINS=https://orderq.example.com

# Hive (company SSO) — leave HIVE_URL empty to disable SSO entirely
HIVE_URL=
SSO_ALLOWED_EMAIL_DOMAINS=brightskiesinc.com
